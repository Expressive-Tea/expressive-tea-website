---
const linkColumns = [
  {
    heading: 'Green Tea',
    links: [
      { label: 'Site', href: 'https://green-tea.expressive-tea.io', external: true },
      { label: 'Docs', href: 'https://green-tea.expressive-tea.io/docs', external: true },
      { label: 'matcha CLI', href: 'https://github.com/Expressive-Tea/matcha', external: true },
      { label: 'npm', href: 'https://www.npmjs.com/package/@green-tea/core', external: true },
    ],
  },
  {
    heading: 'Expressive Tea',
    links: [
      { label: 'Docs', href: 'https://docs.expressive-tea.io', external: true },
      { label: 'Code', href: 'https://github.com/Expressive-Tea/expresive-tea', external: true },
      { label: 'npm', href: 'https://www.npmjs.com/package/@expressive-tea/core', external: true },
    ],
  },
  {
    heading: 'Organization',
    links: [
      { label: 'GitHub', href: 'https://github.com/Expressive-Tea', external: true },
      { label: 'Privacy', href: '/privacy-policy', external: false },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div>
      <span class="wordmark">
        <span>Expressive Tea</span><span class="wordmark__software">Software</span>
      </span>
      <p class="site-footer__tagline">Open source, built in Mexico.</p>
    </div>

    <nav class="site-footer__columns" aria-label="Footer">
      {
        linkColumns.map((column) => (
          <div>
            <p class="site-footer__heading">{column.heading}</p>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? '_blank' : undefined}
                    rel={link.external ? 'noopener noreferrer' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="wrap site-footer__bottom">
    <p>© {year} Expressive Tea Software · Hecho en México 🇲🇽 · That's the tea. 🍵</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--panel);
    padding-block: clamp(2.5rem, 6vw, 3.5rem) 1.5rem;
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2.5rem;
  }

  .site-footer .wordmark {
    font-size: 1.05rem;
  }

  .site-footer__tagline {
    color: var(--cool);
    margin: 0.5em 0 0;
    font-size: 0.95rem;
  }

  .site-footer__columns {
    display: flex;
    flex-wrap: wrap;
    gap: 3rem;
  }

  .site-footer__heading {
    color: var(--white);
    font-weight: 600;
    margin: 0 0 0.75em;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .site-footer__columns ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55em;
  }

  .site-footer__columns a {
    color: var(--cool);
    font-size: 0.95rem;
  }

  .site-footer__columns a:hover,
  .site-footer__columns a:focus-visible {
    color: var(--green);
  }

  .site-footer__bottom {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--graphite) 60%, var(--panel));
  }

  .site-footer__bottom p {
    margin: 0;
    color: var(--meta);
    font-size: 0.875rem;
  }

  @media (max-width: 560px) {
    .site-footer__columns {
      gap: 2rem;
    }
  }
</style>
